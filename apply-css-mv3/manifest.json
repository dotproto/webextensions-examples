{
  "description": "Adds a page action to toggle applying CSS to pages.",
  "manifest_version": 3,
  "name": "apply-css",
  "version": "1.0",
  "homepage_url": "https://github.com/mdn/webextensions-examples-mv3/tree/master/apply-css",
  "browser_specific_settings": {
    "gecko": {
      "id": "apply-css@mozilla.org"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "page_action": {
    "default_icon": "icons/off.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ]
}
